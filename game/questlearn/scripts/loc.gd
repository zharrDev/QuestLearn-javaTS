func _ready() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS) == OK:
		locale = str(cfg.get_value("ui", "language", "id"))
	if not STRINGS.has(locale):
		locale = "id"

func set_locale(code: String) -> void:
	if STRINGS.has(code):
		locale = code

func t(key: String) -> String:
	var table: Dictionary = STRINGS.get(locale, STRINGS["en"])
	if table.has(key):
		return str(table[key])
	var fallback: Dictionary = STRINGS["en"]
	return str(fallback.get(key, key))

func tf(key: String, values: Array) -> String:
	return t(key) % values
